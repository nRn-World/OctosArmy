# --- OctosArmy / OctoSync AI (Python + Ollama, local engine) ---
# Sandbox: only this directory is used by `python -m octosync`
SANDBOX_ROOT=./workspace
# Ollama API (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag as in `ollama list` (use the exact name you pulled)
OLLAMA_MODEL=gemma4:e4b

# --- Backend (server.ts) ---
# Port for the local Express API/UI. The Electron shell reads this too.
OCTOS_PORT=3000
# If the UI is not served by the backend itself, point it here, e.g.
# VITE_API_BASE_URL=http://127.0.0.1:3000
# Max agent steps, terminal timeout (seconds), max terminal output (characters)
OCTOSARMY_MAX_STEPS=200
OCTOSARMY_TERMINAL_TIMEOUT=60
OCTOSARMY_MAX_TERMINAL_OUTPUT=50000
# Optional override for which Python interpreter the allowlisted terminal uses
# OCTOSARMY_PYTHON=py

# --- Secrets ---
# Do NOT commit tokens here. Publishing releases only needs GH_TOKEN in the shell
# environment (or in a private file outside this repository) when running `npm run dist`.
#
# The backend serves the UI with a per-start session token it injects into the HTML it
# sends. Never hardcode or check that token in; it is regenerated on every start.

# --- Model call limits ---
# Hard ceiling per call to Ollama (seconds). A 14B reasoning model on a partly
# CPU-offloaded GPU can spend many minutes on a single step; this stops a wedged
# call from hanging the UI forever.
OCTOSARMY_OLLAMA_TIMEOUT=900
# If the model emits nothing at all for this many seconds, the call is treated as dead.
OCTOSARMY_OLLAMA_STALL=90
